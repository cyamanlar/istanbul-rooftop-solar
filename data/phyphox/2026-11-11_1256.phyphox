<?xml version="1.0" encoding="UTF-8"?><phyphox version="1.14">
  <icon format="base64"></icon>
  <link label="Wiki">http://phyphox.org/wiki/index.php?title=Sensor:_Light</link>
  <translations>
    <translation locale="en">
      <title>Light</title>
      <category>Raw Sensors</category>
      <description>Get raw data from the light sensor.</description>
      <string original="Info">
                Note: On some devices the light sensor is only updated when there is a coarse change of illuminance.
            </string>
    </translation>
    <translation locale="de">
      <title>Licht</title>
      <category>Sensoren</category>
      <description>Rohdaten des Lichtsensors auslesen.</description>
      <string original="Illuminance">Beleuchtungsstärke</string>
      <string original="Simple">Einfach</string>
      <string original="Info">
                Auf manchen Geräten wird der Wert des Lichtsensors nur aktualisiert, wenn sich eine große Änderung der Beleuchtungsstärke ergibt.
            </string>
    </translation>
    <translation locale="cs">
      <title>Světlo</title>
      <category>Senzory</category>
      <description>Zobrazí neupravená data ze senzoru osvětlení.</description>
      <string original="Graph">Graf</string>
      <string original="Illuminance">Osvětlení</string>
      <string original="Simple">Stručně</string>
      <string original="Info">
                Poznámka: Na některých zařízeních světelný senzor obnovuje údaje, pouze když dojde k výrazné změně osvětlení.
            </string>
    </translation>
    <translation locale="pl">
      <title>Światło</title>
      <category>Surowe dane</category>
      <description>Uzyskaj surowe dane z czujnika światła.</description>
      <string original="Graph">Wykres</string>
      <string original="Illuminance">Natężenie oświetlenia</string>
      <string original="Info">
                Komentarz: W niektórych urządzeniach status czujnika światła jest zapisywany jedynie w przypadku znacznych zmian natężenia światła padającego na czujnik.
            </string>
      <string original="Simple">Próbka</string>
    </translation>
    <translation locale="nl">
      <title>Licht</title>
      <category>Onbewerkte sensoren</category>
      <description>Verkrijg onbewerkte data van de lichtsensor.</description>
      <string original="Graph">Grafiek</string>
      <string original="Illuminance">Verlichting</string>
      <string original="Info">
                Opmerking: op sommige apparaten wordt de lichtsensor alleen gereset als de verlichtingssterkte sterk verandert.
            </string>
      <string original="Simple">Eenvoudig</string>
    </translation>
    <translation locale="ru">
      <title>Свет</title>
      <category>Исходные датчики</category>
      <description>Получите исходные данные с датчика освещенности.</description>
      <string original="Graph">График</string>
      <string original="Illuminance">Освещённость</string>
      <string original="Info">
                Примечание: на некоторых устройствах датчик освещенности реагирует только на сильное изменение светового потока.
            </string>
      <string original="Simple">Значение</string>
    </translation>
    <translation locale="it">
      <title>Luce</title>
      <category>Sensori</category>
      <description>Legge i dati dal sensore di luminosità.</description>
      <string original="Graph">Grafico</string>
      <string original="Illuminance">Illuminamento</string>
      <string original="Info">
                Nota: su alcuni dispositivi il sensore di luminosità si aggiorna soltanto quando si verifica una considerevole variazione di illuminazione.
            </string>
      <string original="Simple">Valori</string>
    </translation>
    <translation locale="el">
      <title>Φως</title>
      <category>Δεδομένα Αισθητήρων</category>
      <description>Πάρτε τις καταγραφές του αισθητήρα φωτός.</description>
      <string original="Graph">Γράφημα</string>
      <string original="Illuminance">Φωτεινότητα</string>
      <string original="Info">
                Παρατήρηση:  Σε μερικές συσκευές ο αισθητήρας φωτός αντιλαμβάνεται μόνο έντονες διαφορές στη φωτεινότητα.
            </string>
      <string original="Simple">Απλό</string>
    </translation>
    <translation locale="ja">
      <title>光</title>
      <category>センサー出力</category>
      <description>光センサ出力の時系列データの取得．</description>
      <string original="Graph">グラフ</string>
      <string original="Illuminance">照度</string>
      <string original="Info">
                注意:いくつかのデバイスの光センサーは照度の大きな変化がある際にのみ更新されます．
            </string>
      <string original="Simple">シンプル</string>
    </translation>
    <translation locale="pt">
      <title>Luz</title>
      <category>Sensores</category>
      <description>Obtenha o dado puro do sensor de luz.</description>
      <string original="Graph">Gráfico</string>
      <string original="Illuminance">Iluminância</string>
      <string original="Info">
                Nota: Em alguns aparelhos o sensor de luz é atualizado apenas quando há uma mudança significativa na luminosidade.
            </string>
      <string original="Simple">Simples</string>
    </translation>
    <translation locale="tr">
      <title>Işık</title>
      <category>Ham Sensörler</category>
      <description>Işık sensöründen ham veri alın.</description>
      <string original="Graph">Grafik</string>
      <string original="Illuminance">Aydınlık</string>
      <string original="Info">
                Dikkat: Bazı cihazlarda, ışık sensörü yalnızca aşırı bir aydınlık değişimi olduğunda güncellenir.
            </string>
      <string original="Simple">Basit</string>
    </translation>
    <translation locale="zh_Hant">
      <title>光</title>
      <category>原始感測器</category>
      <description>由光感測器得原始數據。</description>
      <string original="Graph">圖表</string>
      <string original="Illuminance">照度</string>
      <string original="Info">
                注意：在一些裝置上，光感測器只在有大的明亮度變化時才會更新數據。
            </string>
      <string original="Simple">簡易</string>
    </translation>
    <translation locale="fr">
      <title>Luminosité</title>
      <category>Capteurs</category>
      <description>Données brutes du capteur de lumière.</description>
      <string original="Graph">Graphe</string>
      <string original="Illuminance">Éclairement lumineux</string>
      <string original="Info">
                Note : sur certains smartphone, le capteur de lumière ne met à jour sa mesure qu'en cas de grande variation d'intensité lumineuse.
            </string>
      <string original="Simple">Composantes</string>
    </translation>
    <translation locale="vi">
      <title>Ánh sáng</title>
      <category>Cảm biến thô</category>
      <description>Lấy dữ liệu thô từ cảm biến ánh sáng.</description>
      <string original="Graph">Đồ thị</string>
      <string original="Illuminance">Độ sáng</string>
      <string original="Info">
                Lưu ý: Trên một số thiết bị, cảm biến ánh sáng chỉ được cập nhật khi có sự thay đổi độ sáng.
            </string>
      <string original="Simple">Đơn giản</string>
    </translation>
    <translation locale="zh_Hans">
      <title>亮度</title>
      <category>原始传感器</category>
      <description>从光传感器获取原始数据。</description>
      <string original="Graph">图表</string>
      <string original="Illuminance">照度</string>
      <string original="Info">
                注意：在一些装置上，光传感器只有出现大的亮度变化时才会更新数据。
            </string>
      <string original="Simple">简明值</string>
    </translation>
    <translation locale="sr">
      <title>Svetlost</title>
      <category>Senzori</category>
      <description>Preuzmite neobrađene podatke iz svetlosn0og senzora.</description>
      <string original="Graph">Grafik</string>
      <string original="Illuminance">Osvetljenost</string>
      <string original="Info">
                Napomena: Na nekim uređajima svetlosni senzor se ažurira isključivo kada postoji gruba promena osvetljenosti.
            </string>
      <string original="Simple">Jednostavno</string>
    </translation>
    <translation locale="sr_Latn">
      <title>Svetlost</title>
      <category>Senzori</category>
      <description>Preuzmite neobrađene podatke iz svetlosn0og senzora.</description>
      <string original="Graph">Grafik</string>
      <string original="Illuminance">Osvetljenost</string>
      <string original="Info">
                Napomena: Na nekim uređajima svetlosni senzor se ažurira isključivo kada postoji gruba promena osvetljenosti.
            </string>
      <string original="Simple">Jednostavno</string>
    </translation>
    <translation locale="es">
      <title>Luz</title>
      <category>Sensores</category>
      <description>Obtenga datos sin procesar del sensor de luz.</description>
      <string original="Graph">Gráfico</string>
      <string original="Illuminance">Iluminancia</string>
      <string original="Info">
                Nota: En algunos dispositivos, el sensor de luz solo se actualiza cuando hay un cambio brusco de iluminancia.
            </string>
    </translation>
    <translation locale="ka">
      <title>სინათლე</title>
      <category>დაუმუშავებელი სენსორები</category>
      <description>მიიღე დაუმუშავებელი მონაცემები სინათლის სენსორისგან.</description>
      <string original="Graph">გრაფიკი</string>
      <string original="Illuminance">ლუმინესცენცია</string>
      <string original="Info">
                ყურადღება მიაქციე, რომ ზოგ ტელეფონში სინათლის სენსორის განახლება მხოლოდ უხეშ ცვლილებაზე ხდება.
            </string>
      <string original="Simple">მარტივი</string>
    </translation>
    <translation locale="hi">
      <title>प्रकाश</title>
      <category>रॉ सेंसर</category>
      <description>प्रकाश सेंसर से कच्चा डाटा प्राप्त करें |</description>
      <string original="Graph">ग्राफ</string>
      <string original="Illuminance">प्रकाश तीव्रता</string>
      <string original="Info">
                नोट: कुछ उपकरणों पर प्रकाश संवेदक (सेंसर) केवल तभी अपडेट किया जाता है जब रोशनी में बड़ा परिवर्तन होता है।
            </string>
      <string original="Simple">साधारण (सामान्य)</string>
    </translation>
    <translation locale="ta">
      <title>ஒளி</title>
      <category>மூல உணர்விகள்</category>
      <description>ஒளி உணர்வியிலிருந்து மூலத் தரவைப் பெறுங்கள்.</description>
      <string original="Graph">வரைபடம்</string>
      <string original="Illuminance">ஒளிர்வு</string>
      <string original="Info">
                குறிப்பு: சில சாதனங்களில் ஒளி உணரி வெளிச்சத்தில் குறிப்பிட்ட மாற்றம் இருக்கும்போது மட்டுமே புதுப்பிக்கப்படும்.
            </string>
      <string original="Simple">எளிமையான</string>
    </translation>
    <translation locale="bn">
      <string original="Illuminance">আলোকীয়  তীব্রতা</string>
    </translation>
    <translation locale="gu">
      <title>લાઈટ</title>
      <category>રો સેન્સર</category>
      <description>લાઇટ સેન્સરમાંથી કાચો ડેટા મેળવો.</description>
      <string original="Graph">આલેખ</string>
      <string original="Illuminance">પ્રકાશિત (ઇલ્યૂમિનેશન)</string>
      <string original="Info">
                નોંધ: કેટલાક ઉપકરણો પર લાઇટ સેન્સર ફક્ત ત્યારે જ અપડેટ થાય છે જ્યારે પ્રકાશમાં થોડો ફેરફાર થાય છે.
            </string>
      <string original="Simple">સિમ્પલ</string>
    </translation>
    <translation locale="kn"/>
    <translation locale="or"/>
    <translation locale="ko">
      <title>빛</title>
      <category>기본 센서 (raw sensors)</category>
      <description>광센서에서 원 데이터를 가져옵니다.</description>
      <string original="Graph">그래프</string>
      <string original="Illuminance">조도</string>
      <string original="Info">
                주의: 일부 장치에서는 조도가 크게 변하는 경우에만 광센서가 업데이트됩니다.
            </string>
      <string original="Simple">단순</string>
    </translation>
  </translations>
